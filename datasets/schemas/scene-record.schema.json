{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "kind", "source_group", "rights", "split", "global_prompt", "subjects", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["synthetic_example", "licensed_source", "model_generated"]},
    "source_group": {"type": "string", "minLength": 1},
    "rights": {"type": "string", "minLength": 1},
    "split": {"enum": ["example", "train", "validation", "test"]},
    "global_prompt": {"type": "string", "minLength": 1},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}},
    "shots": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "prompt", "subject_ids", "preserve", "change"], "properties": {"id": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}, "subject_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "preserve": {"type": "array", "items": {"type": "string"}}, "change": {"type": "array", "items": {"type": "string"}}, "media_url": {"type": ["string", "null"], "format": "uri"}}}}
  }
}
